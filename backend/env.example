# ---- Server ----
PORT=4000
# Comma-separated list of allowed browser origins (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Firebase Admin ----
# base64 of the service-account JSON downloaded from Firebase console:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
#   bash:       base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Bucket name shown in Firebase console → Storage (new projects: <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ---- Data ----
# Optional. Defaults to ../data/markham_rules.json relative to this folder.
RULES_PATH=

# ---- Demo mode ----
# true = skip Firebase token checks (uid "demo-user") so the demo frontend can call the API.
# NEVER set to true in production.
DEMO_MODE=false
