# Copy to frontend/.env.local. Never commit real values.
#
# Leave every NEXT_PUBLIC_FIREBASE_* blank to run in DEMO MODE (local dev only: no sign-in, data
# stays in the browser). Production needs all of them.

# ---- Firebase (console → Project settings → Your apps → Web app) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ---- Cloudinary unsigned uploads for listing / handover photos ----
# cloudinary.com → Dashboard (cloud name) → Settings → Upload → Add upload preset → Signing mode: Unsigned
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---- Gemini, server-side only (read by src/app/api/scan/route.ts; never shipped to the browser) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Markham Civic Centre — fallback when geolocation is denied ----
NEXT_PUBLIC_DEFAULT_LAT=43.8561
NEXT_PUBLIC_DEFAULT_LNG=-79.3370

# ---- Optional: serve Firebase Auth helpers from your own domain (see netlify.toml) ----
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecoloopmarkham.netlify.app
