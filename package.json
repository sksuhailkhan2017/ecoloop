{
  "name": "ecoloop",
  "version": "1.0.0",
  "private": true,
  "description": "EcoLoop \u2014 scan it, sort it, share it. Markham's waste-reduction app: one Next.js app (frontend/) on Firebase + Cloudinary + Gemini; data tooling in python/.",
  "scripts": {
    "install:all": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "validate:rules": "python python/scripts/validate_rules.py"
  },
  "engines": {
    "node": ">=20"
  }
}
